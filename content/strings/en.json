  "c_hild.bark.call.01": {
    "text": "Here! Over here, past the rocks!",
    "tags": ["ADDRESS_STEERER", "VOICED"]
  },
  "c_hild.bark.call.02": {
    "text": "Is that you? I'm by the rocks. The water's coming in!",
    "tags": ["ADDRESS_STEERER", "VOICED"]
  },
  "c_hild.bark.call.03": {
    "text": "Over here! I'd come to you, but my leg has other ideas.",
    "tags": ["ADDRESS_STEERER", "VOICED"]
  },
  "c_hild.bark.found.01": {
    "text": "{steerer}! The sea spat you out too. Get me up the beach before it changes its mind.",
    "tags": ["ADDRESS_STEERER", "VOICED"]
  },
  "c_hild.bark.tide.01": {
    "text": "Not here. The tide comes this far. Higher, up past the weed.",
    "tags": ["ADDRESS_STEERER", "VOICED"]
  },
  "c_hild.bark.safe.01": {
    "text": "That'll do. The sea's not having either of us today.",
    "tags": ["ADDRESS_STEERER", "VOICED"]
  },
