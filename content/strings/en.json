  "c_hild.bark.broch.01": {
    "text": "There's an old broch up past the bank. Walls, at least. Come on.",
    "tags": ["ADDRESS_STEERER", "VOICED"]
  },
  "c_hild.bark.broch.02": {
    "text": "Keep up. My leg's worse than yours.",
    "tags": ["ADDRESS_STEERER", "VOICED"]
  },
  "c_hild.bark.broch.03": {
    "text": "Dry, near enough. We need a fire. Driftwood's along the weed line.",
    "tags": ["ADDRESS_STEERER", "VOICED"]
  },
  "c_hild.bark.fire.01": {
    "text": "That's better. Now see to this leg before it sets crooked.",
    "tags": ["ADDRESS_STEERER", "VOICED"]
  },
  "c_hild.bark.tended.01": {
    "text": "Tight. Good. You've done that before.",
    "tags": ["ADDRESS_STEERER", "VOICED"]
  },
  "c_hild.bark.meal.01": {
    "text": "Hot food. The sea can keep the rest of us.",
    "tags": ["ADDRESS_STEERER", "VOICED"]
  },
  "c_hild.bark.fishing.01": {
    "text": "I can't walk far, but I can fish. I'll be on the rocks below the path.",
    "tags": ["ADDRESS_STEERER", "VOICED"]
  },
  "c_hild.bark.fish.01": {
    "text": "There. Supper, if you can cook it.",
    "tags": ["ADDRESS_STEERER", "VOICED"]
  },
  "c_hild.bark.shelter.01": {
    "text": "A roof. Father's sail, keeping us dry. He'd laugh.",
    "tags": ["ADDRESS_STEERER", "VOICED"]
  },
  "c_hild.bark.evening.01": {
    "text": "Sleep when you can. I'll keep the fire in.",
    "tags": ["ADDRESS_STEERER", "VOICED"]
  },
